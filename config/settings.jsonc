// HoundMind master configuration (PiDog hardware only)
// This is the only user-facing config file. It is plain text with comments.
// All options are live-tuned by editing this file and restarting the runtime.
{
  // Which board is this? "auto" reads the device tree, which is the only default that can be
  // true on more than one machine; `HOUNDMIND_PROFILE` overrides it at launch. The answer is
  // `pi4`, `pi5`, `unsupported` (Pi 3 and older, refused with a message) or `unknown` (no
  // device tree: CI, a workstation, a container — those run `pi4`).
  "profile": "auto",
  "profiles": {
    "pi4": {
      "loop": {
        "tick_hz": 10,
        "max_cycles": null
      },
      "modules": {
        // Off until `python -c "import picamera2"` succeeds inside the venv (#215). The binding is
        // a Debian package (`python3-picamera2`), not a wheel, so an image without it left this
        // module logging `Picamera2 unavailable` on every start while claiming to be enabled.
        "vision_pi4": {"enabled": false},
        "face_recognition": {"enabled": false},
        "semantic_labeler": {"enabled": false},
        "slam_pi4": {"enabled": false}
      },
      "settings": {
        "navigation": {
          "scan_interval_s": 0.3,
          "scan_interval_min_s": 0.2,
          "scan_interval_max_s": 1.5
        },
        "vision_pi4": {
          "frame_interval_s": 0.1
        }
      }
    },
    "pi5": {
      // Deliberately the same cadence and the same enablement as `pi4`. A faster loop is a
      // claim that needs a measurement, and nothing has been measured on a Pi 5 yet.
      "loop": {
        "tick_hz": 10,
        "max_cycles": null
      },
      "modules": {
        // Same reason as `pi4`: the camera binding has to be importable first (#215).
        "vision_pi4": {"enabled": false},
        "face_recognition": {"enabled": false},
        "semantic_labeler": {"enabled": false},
        "slam_pi4": {"enabled": false}
      },
      "settings": {
        "navigation": {
          "scan_interval_s": 0.3,
          "scan_interval_min_s": 0.2,
          "scan_interval_max_s": 1.5
        },
        "vision_pi4": {
          "frame_interval_s": 0.1
        },
        "performance": {
          // A Pi 5 idles near 65 C with no cooler and begins to throttle at 80 C, so the
          // generic 70 C warning marks a healthy board as degraded — and degradation pulls the
          // `throttle_scans` lever, halving the scan rate for no reason. These are the board
          // figures with a little headroom, not a tuning preference.
          "health_temp_warn_c": 78.0,
          "health_gpu_temp_warn_c": 80.0
        }
      }
    },
    // The end-user set. `auto` picks a board; this one picks a dog that is left running: the
    // 10 Hz loop the board profiles use, and the read-only health sampler on so the console can
    // show CPU and temperature. Everything else is inherited on purpose - `safety`,
    // `sensor_health` and `balance` stay off until the 30-minute soak (#26) is recorded, and a
    // profile must never flip a safety module on its own.
    "pet": {
      "loop": {
        "tick_hz": 10,
        "max_cycles": null
      },
      "modules": {
        "health": {"enabled": true}
      }
    }
  },
  "loop": {
    // Main loop frequency in Hz.
    "tick_hz": 5,
    // Max cycles to run; set null for continuous operation.
    // A finite value here stops the runtime, which is useful for tests and useless for a
    // robot: the shipped default used to be 10, so a fresh install ran for two seconds and
    // quit. Continuous is the only sane default for a service.
    "max_cycles": null
  },
  "modules": {
    "hal": {
      // Owns the dog. Every hardware-facing module asks the context for `hal`, so this must
      // stay enabled: with it off nothing can move and no sensor is read.
      "enabled": true,
      "required": false
    },
    "hal_sensors": {
      // Sensor polling on top of the HAL (ultrasonic, touch, sound direction, IMU).
      "enabled": true,
      // Required modules will stop the runtime if they fail to start.
      "required": true
    },
      "scanning": {
        // Head scan service (three-way or sweep). Reactive feed for navigation.
        "enabled": true,
        "required": false
      },
      "orientation": {
        // IMU heading integration (gyro Z -> heading).
        "enabled": true,
        "required": false
      },
      "odometry": {
        // Step odometry: heading x counted steps -> a relative pose. An observer, moves nothing.
        "enabled": true,
        "required": false
      },
      "localization": {
        // Picks the best available pose (SLAM -> dead reckoning -> none) and says why it degraded.
        "enabled": true,
        "required": false
      },
    "hal_motors": {
      // Enable motor HAL (ActionFlow + servo actions).
      "enabled": true,
      "required": true
    },
    "motion_gateway": {
      // Resolves competing motion intents and applies the interlock.
      // Leave this on: with it off, the motors receive no command at all.
      "enabled": true,
      "required": false
    },
    "api": {
      // The control plane: REST + WebSocket + MJPEG + the web app on one port.
      // This is the only network surface in the runtime. Turning it off leaves the dog fully
      // operational with nothing listening, which is the right choice for a dog that should
      // never be reachable. Authentication is not optional when it is on: every route except
      // /api/v1/meta and /api/v1/health requires the install-issued token.
      "enabled": true,
      "required": false
    },
    "sensor_health": {
      // Per-sensor staleness badge and LED colour. Off by default, like the other safety
      // modules; the raw validity flags are published regardless.
      "enabled": false,
      "required": false
    },
    "perception": {
      // Sensor fusion and signal extraction.
      "enabled": true,
      "required": false
    },
    "navigation": {
      // Obstacle avoidance + navigation cues.
      // Tuning lives under settings.navigation: anything else placed here is ignored,
      // because the runtime only reads `enabled` and `required` from this entry.
      "enabled": true,
      "required": false
    },
    "mapping": {
      // Mapping and optional home map storage. Tuning lives under settings.mapping.
      "enabled": true,
      "required": false
    },
    "room_context": {
      // Names the room the pose falls in, from the home map (`/state.room`). An observer: it reads
      // the localization pose and the drawn rooms, and moves nothing.
      "enabled": true,
      "required": false
    },
    "behavior": {
      // High-level behavior selection.
      "enabled": true,
      "required": false
    },
    "routine_runner": {
      // Plays a user-authored routine from settings.routines.dir, one step per tick, as a
      // `routine` intent through the gateway — the interlock, the obstacle stop and the mode gate
      // apply to it exactly as they do to a command from a hand. With it off, /api/v1/routines
      // answers 503 and /meta stops advertising `routines`; nothing else changes. The file format
      // is docs/ROUTINES.md.
      "enabled": true,
      "required": false
    },
    "attention": {
      // Head attention to sound direction.
      "enabled": true,
      "required": false
    },
    "place_navigator": {
      // Walks to a place in the file at settings.places.path by publishing `place` intents (priority
      // 17, under `navigation`, so an obstacle always wins the tick). It is inert until something
      // writes the `place_request` context key — the control plane's `POST /api/v1/places/{id}/go`
      // does that — and with it off a request is simply never answered. It also builds the one
      // `PlaceStore` and publishes it as `place_store`, which the `/places` routes write through;
      // turn this off and those routes answer 503 rather than inventing a second writer.
      // Tuning lives in `settings.places`, not here.
      "enabled": true,
      "required": false
    },
    "place_recognition": {
      // Recognises the place the dog is standing in from a camera view (perception/place_views.py):
      // publishes `place_match` every scored frame and, when two frames agree, re-anchors odometry
      // and promotes localization to the `place` tier. Off by default: it is a second consumer of
      // the camera, and enabling it costs CPU on every install that also runs vision.
      // Tuning lives in `settings.place_recognition`, not here.
      "enabled": false,
      "required": false
    },
    "route_follower": {
      // Plans one route from the map and walks it waypoint by waypoint at `Source.ROUTE` (19): above
      // a place goal, below the navigator, so a plan never outvotes an obstacle. Inert until
      // something writes `route_request`, and it refuses to plan at all from the `reactive` tier -
      // a route is drawn in map coordinates and a dog with no pose cannot say where along it it is.
      // Tuning lives in `settings.route_follower`, not here.
      "enabled": false,
      "required": false
    },
    "calibration": {
      // Calibration workflows (disabled by default).
      "enabled": false,
      "required": false
    },
      "event_log": {
        // Event logger (lightweight). Can be disabled.
        "enabled": true,
        "required": false
      },
    "decision_log": {
      // Decision feed: the last decisions in a bounded ring, plus an optional JSONL mirror.
      // Kept separate from the event logger so `/decisions` works when the event log is off.
      "enabled": true,
      "required": false
    },
      "health": {
        // Lightweight system health monitor.
        "enabled": false,
        "required": false
      },
      "watchdog": {
        // Holds motion when sensor/scan data is stale, and restarts modules that stopped
        // ticking. Recovery is always "stop and report" — it never poses the dog.
        "enabled": true,
        "required": false
      },
      "balance": {
        // IMU balance compensation module.
        "enabled": false,
        "required": false
      },
    "safety": {
      // Safety overrides (emergency backing, etc.).
      "enabled": false,
      "required": false
    },
    "vision": {
      // Camera-based modules (disabled until tested).
      "enabled": false,
      "required": false
    },
    "vision_pi4": {
      // Pi4 vision feed (disabled by default).
      "enabled": false,
      "required": false
    },
    "assistant": {
      // Cloud or LAN language model (disabled by default). It answers questions through the voice
      // module and cannot command motion - the phrase map still owns every command.
      "enabled": false,
      "required": false
    },
    "voice": {
      // Voice interaction modules (disabled until tested).
      "enabled": false,
      "required": false
    },
    "face_recognition": {
      // Pi4 face recognition module (disabled by default).
      "enabled": false,
      "required": false
    },
    "semantic_labeler": {
      // Pi4 semantic labeling (disabled by default).
      "enabled": false,
      "required": false
    },
    "slam_pi4": {
      // Pi4 SLAM module (disabled by default).
      "enabled": false,
      "required": false
    },
    "energy_emotion": {
      // Derived emotion feedback (disabled by default). A consumer of `settings.energy`: with
      // `settings.energy.enabled: false` there is no reading, so this publishes nothing and says so.
      "enabled": false,
      "required": false
    },
    "led_manager": {
      // Centralized LED manager (recommended).
      "enabled": true,
      "required": false
    }
  },
  "settings": {
    // Four keys below can be changed at runtime and on disk by `PATCH /api/v1/config`:
    // `behavior.action_cooldown_s`, `led.brightness`, `motors.min_action_interval_s` and
    // `navigation.safe_distance_cm` (#174). The write is surgical - the value's bytes are replaced and
    // these comments survive - and it is refused with 409 if this file changed since the runtime
    // started. Everything else here is read at start-up only.
    // =====================================================================
    // DEVICE IDENTITY
    // =====================================================================
    "device": {
      // Stamped on every log record and reported as `device_id` by GET /api/v1/meta.
      // Empty means "use the hostname".
      "device_id": ""
    },
    // =====================================================================
    // SENSORS (reactive sensor service)
    // =====================================================================
    "sensors": {
      // Sensor polling cadence (Hz). The loop cannot sample faster than it ticks.
      "poll_hz": 10,
      // Max sensor snapshots to keep in history.
      "history_size": 10,
      // Enable/disable individual sensors.
      "enable_ultrasonic": true,
      "enable_touch": true,
      "enable_sound": true,
      "enable_imu": true,
      // Pack voltage reads the ADC on the bus the servos share, so it is polled slower than the
      // rest of the snapshot: the last good value is reported in between (0 = every poll).
      "battery_poll_s": 2.0,
      // Ultrasonic sampling.
      "distance_samples": 3,
      "distance_sample_delay_s": 0.03,
      "distance_use_median": true,
      // Ignore repeated distance reads inside this window (seconds).
      "distance_debounce_s": 0.0,
      "distance_min_cm": 2,
      "distance_max_cm": 200,
      // Reject outlier samples using z-score threshold (0 = off).
      "distance_outlier_reject_z": 2.5,
      // EMA smoothing for distance (0 = off, 1 = no smoothing).
      "distance_ema_alpha": 0.0,
      // Touch debounce window to reduce chatter.
      "touch_debounce_s": 0.05,
      // If true, only read sound direction when sound is detected.
      "sound_direction_on_detect": true,
      // IMU low-pass filter smoothing (0 = off, 1 = no smoothing).
      "imu_lpf_alpha": 0.3
    },
    // =====================================================================
    // PERCEPTION (lightweight signal extraction)
    // =====================================================================
    "perception": {
      // Distance threshold (cm) used to flag obstacles.
      "obstacle_cm": 20,
      // Minimal fusion settings for lightweight pose hints.
      "fusion": {
        "fusion_anchor_distance_cm": 120,
        "fusion_min_confidence": 0.3
      },
      // Occupancy (P4 PL3): is somebody in front of the dog? Read from the `faces` payload a
      // detector publishes (`modules.face_recognition`, or any module that fills it), and published
      // in `perception` as `occupancy` + `occupancy_valid` + `occupancy_frames`.
      //
      // The three unknown cases are on purpose: no detector, no frame, or a frame older than
      // `max_age_s` all read as `occupancy: null` / `occupancy_valid: false` — never as an empty
      // room. Claiming somebody is there needs `min_frames` consecutive frames; dropping the claim
      // needs `release_frames` so a blink does not flap it. With no detector configured this does
      // nothing at all, which is the shipped state.
      "occupancy": {
        "max_age_s": 1.0,
        "min_frames": 3,
        "release_frames": 5
      }
    },
    // =====================================================================
    // HABITUATION (suppress repeated stimuli)
    // =====================================================================
    "habituation": {
      "enabled": true,
      // List of stimuli keys to monitor. Modules may consult
      // `habituation:<stimulus>:habituated` in runtime context.
      "stimuli": ["sound", "touch"],
      // Window (s) for counting repeated stimuli
      "window_s": 1.0,
      // Number of events within window to consider habituated
      "threshold": 3,
      // Recovery window (s) of quiet required to reset habituation
      "recovery_s": 6.0
    },
    // =====================================================================
    // FACE RECOGNITION (Pi4 optional)
    // =====================================================================
    "face_recognition": {
      "enabled": false,
      // Backend options: "stub" (default), "opencv" (lite), "face_recognition" (heavy).
      "backend": "stub",
      // Common detection settings.
      "scale_factor": 1.1,
      "min_neighbors": 5,
      "min_face_px": 60,
      // OpenCV (lite) settings.
      "opencv_haar_path": "",
      // Everything a face leaves on disk lives under ~/.houndmind/face, like the token, places and
      // routines. It is biometric data: it has to be writable by the service user, it has to survive
      // a reinstall, and `DELETE /api/v1/people/{id}` has to be able to find it to delete it (#104).
      "lbph": {
        "enabled": true,
        "model_path": "~/.houndmind/face/face_model.yml",
        "dataset_dir": "~/.houndmind/face/dataset",
        "label_map_path": "~/.houndmind/face/face_labels.json",
        "confidence_threshold": 70.0
      },
      // face_recognition (heavy) settings: the embeddings file `GET /api/v1/people` reports as
      // `path`, so a user can find the biometric data and delete it.
      "embeddings_path": "~/.houndmind/face/face_embeddings.json",
      "match_threshold": 0.6
    },
    // =====================================================================
    // PI4 VISION FEED
    // =====================================================================
    "vision_pi4": {
      "enabled": false,
      "backend": "picamera2",
      "device_index": 0,
      // Seconds between captured frames.
      "frame_interval_s": 0.2,
      // Run a vision model on each frame in a background worker. Off by default and inert
      // without a model: enabling it with nothing wired reports "unconfigured" rather than
      // starting the placeholder thread that used to live here.
      "inference_scheduler_enabled": false,
      // Frame preparation before inference. Applied only when the scheduler is running.
      "preprocessing": {
        "resize": [224, 224],
        "normalize": false,
        "roi": null,
        "mean": [0.0, 0.0, 0.0],
        "std": [1.0, 1.0, 1.0]
      }
    },
    // =====================================================================
    // ASSISTANT (language model: a cloud API now, a box on the LAN later)
    // =====================================================================
    "assistant": {
      // Off in both places by default: here and `modules.assistant`.
      "enabled": false,
      // "openai_compatible" speaks the OpenAI chat-completions API, which is why a local model is
      // a config change rather than a second implementation - Ollama, llama.cpp's `llama-server`
      // and LM Studio all expose `/v1/chat/completions`. "none" keeps the block inert.
      "backend": "none",
      // Cloud: "https://api.openai.com/v1" (or an OpenRouter / Groq base URL).
      // Local: "http://<this-pc-on-the-lan>:11434/v1" with "model": "qwen3.5:4b".
      "base_url": "",
      "model": "",
      // Spoken aloud, so brevity is a feature. It must never claim the dog can do something it
      // cannot, and it never commands motion - the phrase map in `voice_assistant` owns commands.
      "system_prompt": "You are the voice of a small robot dog. Answer in one or two short sentences, plainly, and never claim you can do something you cannot.",
      "max_tokens": 256,
      // A dead link must cost the answer, not the tick: the worker gives up after this, and the
      // module disables itself after `max_failures` consecutive failures.
      "timeout_s": 8.0,
      "requests_per_minute": 10,
      "max_failures": 3,
      // A busy provider (429/5xx) is retried this many times, honouring `Retry-After`, and is never
      // counted against `max_failures`: a free tier throttles the dog, it does not break it (#250).
      "max_transient_retries": 3,
      // The key is never in this file - this repo publishes its config. Set the environment
      // variable, or write the key into a 0600 file; the environment wins when both exist.
      "api_key_env": "LLM_API_KEY",
      "api_key_path": "~/.houndmind/llm_key"
    },
    // =====================================================================
    // VOICE ASSISTANT (Pi4 optional)
    // =====================================================================
    "voice_assistant": {
      "enabled": false,
      // Minimum seconds between accepted commands.
      "cooldown_s": 1.0,
      // Speech-to-text settings
      "stt": {
        "enabled": false,
        "backend": "speech_recognition",
        "vosk_model_path": ""
      },
      // Text-to-speech settings. `enabled: false` keeps the module silent even when it
      // answers a question. `backend` picks the voice: the vendor engines speak through the Robot
      // HAT speaker - "piper" (offline neural), "edge" (network), "espeak", "pico2wave" - and
      // "auto" walks those and then falls back to pyttsx3. "pidog" is kept as the compatibility
      // name for that vendor path; naming one engine disables every other path. The vendor engines
      // need `sunfounder-voice-assistant` (installed by the installer), pyttsx3 needs `espeak-ng`,
      // and both need the HAT speaker (#245, #246).
      "tts": {
        "enabled": false,
        "backend": "auto",
        // Piper's model, downloaded into `~/.piper_models/` on first use (offline neural voice,
        // the best fit for a dog with no network). Empty means "skip Piper" - without a model Piper
        // cannot speak, and `auto` moves on to the next engine instead (#249).
        "piper_model": ""
      },
      // Map phrases to PiDog actions.
      "command_map": {
        "sit": "sit",
        "stand": "stand",
        "lie": "lie",
        "down": "lie",
        "forward": "forward",
        "back": "backward",
        "backward": "backward",
        "turn left": "turn left",
        "turn right": "turn right",
        "wag": "wag tail",
        "wag tail": "wag tail",
        "shake": "shake head",
        "shake head": "shake head",
        // The escape hatch. `stop` is the one action no layer vetoes - not the tilt latch, not the
        // battery floor, not the mode - so the word an operator shouts must reach it instead of a
        // posture that a dog lying on its side cannot be granted (#386).
        "stop": "stop"
      },
      // Aliases map to other keys in command_map.
      "aliases": {
        "go": "forward",
        "reverse": "backward",
        "halt": "stop",
        "sleep": "lie"
      }
    },
    // =====================================================================
    // SEMANTIC LABELER (Pi4 optional)
    // =====================================================================
    "semantic_labeler": {
      "enabled": false,
      "backend": "stub",
      "interval_s": 0.5,
      // OpenCV DNN settings. `python -m tools.download_opencv_models` writes exactly these three
      // names into `models/`; `backend: "opencv_dnn"` is the switch that turns the detector on.
      "model_path": "models/ssd_mobilenet_v1_coco.pb",
      "config_path": "models/ssd_mobilenet_v1_coco.pbtxt",
      "labels_path": "models/coco_labels.txt",
      "input_width": 320,
      "input_height": 320,
      "confidence_threshold": 0.5
    },
    // =====================================================================
    // PI4 SLAM (stub + backend gating)
    // =====================================================================
    "slam_pi4": {
        "enabled": false,
        // Backend: "stub" (default), "rtabmap" (for full SLAM). The `rtabmap` backend needs the
        // `rtabmap` bindings, which are not on PyPI and no longer have source upstream, so nothing
        // in a normal install provides them: with this backend and no bindings the module logs a
        // warning and falls back to `stub` (dead reckoning, reported by /state), rather than
        // disabling itself. `stub` integrates the gyro - it is dead reckoning, not visual SLAM (#181).
        "backend": "stub",
        // Main SLAM update interval (seconds)
        "interval_s": 0.2,
        // IMU gyro scale (for stub mode)
        "gyro_scale": 0.0,
        // Stub mode confidence value
        "stub_confidence": 0.1,
        // RTAB-Map config (used if backend = "rtabmap")
        "rtabmap": {
          // Path to RTAB-Map database (optional, default: in-memory)
          "database_path": "rtabmap.db",
          // Frame width/height for SLAM (optional, default: auto)
          "frame_width": null,
          "frame_height": null,
          // Use RGB-D (recommended) or monocular
          "rgbd_enabled": true,
          // RTAB-Map parameters (see RTAB-Map docs for full list)
          "parameters": {
            "RGBD/LinearUpdate": 0.1,
            "RGBD/AngularUpdate": 0.1
          }
        },
        // Navigation hint integration
        "nav_hint_enabled": false,
        "nav_target_heading_deg": null,
        "nav_deadband_deg": 10.0
      },
    // =====================================================================
    // NAVIGATION & SCANNING
    // =====================================================================
    // =====================================================================
    // SENSOR HEALTH SUMMARY BADGE (LED/log)
    // =====================================================================
    "sensor_health": {
      // Enable sensor health summary badge (LED/log)
      "enabled": false,
      // LED color for healthy sensors
      "led_ok_color": "green",
      // LED color for warning state
      "led_warning_color": "yellow",
      // LED color for error state
      "led_error_color": "red",
      // Log health status changes
      "log_enabled": true,
      // Ultrasonic sensor: max age (s) before warning
      "ultrasonic_stale_s": 1.0,
      // IMU: max age (s) before warning
      "imu_stale_s": 1.0,
      // Touch: max age (s) before warning
      "touch_stale_s": 1.0,
      // Sound direction: max age (s) before warning
      "sound_stale_s": 1.0,
      // Set to true to treat any error as critical (red LED)
      "error_is_critical": true
    },
    "navigation": {
      // Minimum safe distance (cm) before avoidance triggers.
      "min_distance_cm": 15,
      // Emergency stop distance (cm) for immediate retreat.
      "emergency_stop_cm": 12,
      // Comfortable clearance (cm) for forward movement.
      "safe_distance_cm": 35,
      // ActionFlow action to avoid obstacles.
      "avoid_action": "backward",
      // ActionFlow action when clear and idle.
      "safe_action": "stand",
      // How often to run a head scan (seconds).
      "scan_interval_s": 0.5,
      // Min/max scan interval bounds (seconds).
      "scan_interval_min_s": 0.2,
      "scan_interval_max_s": 2.0,
      // Scan mode: "sweep" (angles) or "three_way" (left/right/forward).
      "scan_mode": "sweep",
      // Run scans continuously in the background.
      "scan_continuous": true,
      // Scan history length for debugging and smoothing.
      "scan_history_size": 10,
      // Ultrasonic samples per scan point.
      "scan_samples": 3,
      // Scan freshness has no key here any more (#22): it is one rule, the larger of
      // watchdog.scan_timeout_s and 1.5x the measured sweep, shared by the navigator and the
      // watchdog.
      // Head scan sweep range (degrees).
      "scan_yaw_max_deg": 60,
      // Head scan step size (degrees).
      "scan_step_deg": 15,
      // Time to settle after a head move (seconds).
      "scan_settle_s": 0.12,
      // Delay between reads in a sweep (seconds).
      "scan_between_reads_s": 0.04,
      // Minimum valid scan points before acting on turn decisions.
      "scan_min_valid_points": 3,
      // Minimum fraction of valid points (0-1) required.
      "scan_min_valid_ratio": 0.5,
      // EMA factor for per-angle baselines.
      "baseline_ema": 0.25,
      // Minimum open gap width in degrees for a valid opening.
      "min_gap_width_deg": 30,
      // Minimum distance (cm) required to count as open space.
      "min_score_cm": 60,
      // Confirmation window for scan decisions.
      "confirm_window": 2,
      // Votes required to confirm a scan decision.
      "confirm_threshold": 2,
      // Minimum confidence ratio required to act on a turn (0-1).
      "turn_confidence_min": 0.6,
      // Cooldown after low-confidence scans (seconds).
      "low_confidence_cooldown_s": 0.8,
      // Retry count for low-confidence scans before fallback.
      "scan_retry_limit": 2,
      // No-go memory: bias away from repeated avoidance directions.
      "no_go_enabled": false,
      // Time window (seconds) to track repeated directions.
      "no_go_window_s": 8.0,
      // Repeats before biasing away from a direction.
      "no_go_repeat_threshold": 3,
      // Head scan speed (PiDog head movement speed).
      "head_scan_speed": 70,
      // Approach detection: absolute delta (cm) from baseline.
      "approach_delta_cm": 10,
      // Approach detection: percent delta from baseline (0-1).
      "approach_delta_pct": 0.25,
      // Window size for approach confirmation votes.
      "approach_confirm_window": 3,
      // Confirmation votes required to treat approach as real.
      "approach_confirm_threshold": 2,
      // Cooldown before another approach response (seconds).
      "approach_cooldown_s": 2.0,
      // How many backward steps to take on approach.
      "backup_steps": 2,
      // Turn angle to use for gap alignment (degrees).
      "turn_degrees_on_gap": 30,
      // Turn direction after retreat: "left", "right", or "auto".
      "retreat_turn_direction": "auto",
      // Turn cooldown to reduce oscillation (seconds).
      "turn_cooldown_s": 0.0,
      // Clear-path streak to skip scans when safe.
      "clear_path_streak_min": 0,
      "clear_path_skip_scans": true,
      // Optional bias from mapping best_path (deg) if available.
      "use_mapping_bias": true,
      "mapping_bias_weight": 0.5,
      "mapping_bias_min_confidence": 0.6,
      "mapping_bias_cooldown_s": 1.0,
      // Use a lightweight occupancy grid for short-range avoidance decisions.
      "use_grid_map": true,
      // Grid cell size (cm) used by grid-bias computations; defaults to mapping.cell_size_cm.
      "grid_cell_size_cm": 10,
      // How far ahead (cm) to consider cells when computing left/right density.
      "grid_influence_depth_cm": 100,
      // Weighting threshold for deciding to prefer one side over another (0-1).
      "grid_bias_weight": 0.7,
      // Optional SLAM navigation hint integration (Pi4 only).
      "slam_nav_enabled": false,
      "slam_nav_override": true,
      "slam_nav_min_confidence": 0.3,
      // Navigation decision logging.
      "log_decision_enabled": true,
      "log_decision_raw_angles": false,
      // Stuck detection (movement magnitude) and avoidance strategy.
      "stuck_time_window_s": 5.0,
      "stuck_movement_threshold": 1500.0,
      "stuck_min_samples": 10,
      "stuck_cooldown_s": 6.0,
      "stuck_strategy_repeat_window_s": 10.0,
      "stuck_strategy_repeat_threshold": 3,
      "avoidance_strategies": ["smart_turn", "backup_turn", "zigzag", "reverse_escape"],
      // Gentle recovery: repeated stuck events reduce the walking speed for a while.
      "gentle_recovery_stuck_count": 3,
      "gentle_recovery_cooldown_s": 8.0,
      // LED feedback for navigation states.
      "led_enabled": true,
      "led_patrol_color": "green",
      "led_turn_color": "orange",
      "led_obstacle_color": "red",
      "led_retreat_color": "red"
    },
    // =====================================================================
    // MOVEMENT & ACTION TUNING
    // =====================================================================
    "movement": {
      // Approximate degrees per single turn step (fallback when orientation is off).
      "turn_degrees_per_step": 15.0,
      // Servo speeds (0-255). `speed_normal` is the reference walking speed the turn
      // speeds are validated against; the turn speeds are what actually reach a servo.
      "speed_normal": 120,
      // Turn speeds (should be faster than walk speeds).
      "speed_turn_slow": 100,
      "speed_turn_normal": 200,
      "speed_turn_fast": 220,
      // How long a navigation retreat stays worth running. It describes the step that just
      // happened, so a stale one is dropped instead of executed late on a dead observation.
      "followup_ttl_s": 1.0,
      // The hard veto on pack voltage: no gait, posture or locomotion below this. The stock 2S
      // pack spans 6.0-8.4 V and browns out under servo load around 7.5 V, so 6.4 V is the floor
      // this build ships (about 3.2 V per cell - essentially empty). You may RAISE it to protect a
      // tired pack; the loader refuses anything below 6.4 V, because widening this one is the way a
      // dog breaks a servo. See `docs/ARCHITECTURE.md` section 5.
      "min_battery_v": 6.4
    },
    // =====================================================================
    // ORIENTATION (IMU heading integration)
    // =====================================================================
    "orientation": {
      "gyro_scale": 1.0,
      "bias_z": 0.0,
      // Optional startup calibration for gyro Z bias.
      "calibration_enabled": true,
      // Wait this long before collecting samples (seconds).
      "calibration_settle_s": 0.3,
      "calibration_duration_s": 2.0,
      "calibration_samples": 30,
      // Clamp bias magnitude (0 = disable clamp).
      "calibration_max_bias_abs": 0.0,
      "initial_heading_deg": 0.0,
      "turn_tolerance_deg": 5.0,
      "turn_timeout_s": 3.0
    },
    // =====================================================================
    // ODOMETRY (steps -> a relative pose; this dog has no wheel encoders)
    // =====================================================================
    "odometry": {
      // Centimetres per issued linear command. A calibrated guess, not a measurement: run
      // `python -m tools.step_calibrate --confirm-clearance` and paste what it prints into
      // `surface_step_cm` below, which overrides this value for the named surface.
      "step_cm": 25.0,
      // The floor surface the dog is walking on right now, chosen by you (the IMU classifier that
      // would guess it is conditional on the measured constants differing between surfaces). An
      // empty string means "no surface chosen", so `step_cm` applies and the pose says `assumed`.
      "surface": "",
      // Measured centimetres per gait cycle, per surface, from `tools.step_calibrate`. A surface
      // listed here wins over `step_cm`; a surface missing here falls back to it and the pose
      // reports `step_cm_source: "assumed"` rather than pretending to be measured.
      "surface_step_cm": {},
      // Count `backward` as a signed step too, or ignore it.
      "track_backward": true
    },
    // =====================================================================
    // LOCALIZATION (which pose to trust, and when to stop trusting it)
    // =====================================================================
    // The ladder is SLAM -> dead reckoning -> no pose, and each rung expires on the numbers below.
    // A SLAM backend that is absent, `stub`, or quiet simply falls through to the next rung.
    "localization": {
      // A SLAM pose older than this is not believed. Measured against the slam module's heartbeat.
      "slam_max_age_s": 2.0,
      // A SLAM pose whose own confidence is below this is not believed either.
      "slam_min_confidence": 0.2,
      // Dead reckoning reaches confidence 0 after this many metres walked since the last fix...
      "dead_reckoning_scale_m": 10.0,
      // ...and after this many seconds since the last fix.
      "dead_reckoning_horizon_s": 120.0,
      // Below this confidence the pose is withdrawn: the dog reports `reactive` with no pose.
      "confidence_floor": 0.15,
      // A confirmed place match keeps the `place` tier this long. Standing still in a room is not
      // evidence against it, so this is generous; the next match replaces the fix, not the clock.
      "place_max_age_s": 30.0
    },
    // =====================================================================
    // MAPPING
    // =====================================================================
    "mapping": {
      // Enable mapping module (safe to keep on by default).
      "enabled": true,
      // Max samples to keep in memory.
      "sample_history_max": 500,
      // Max age for samples in seconds (0 = keep forever).
      "sample_max_age_s": 0,
      // Store a persistent "Home Map" snapshot at intervals.
      "home_map_enabled": false,
      // Max samples to write in a home map snapshot (0 = no cap).
      "home_map_max_samples": 500,
      // Max age for samples in a home map snapshot (seconds, 0 = no cap).
      "home_map_max_age_s": 0,
      // Save interval in seconds for the home map.
      "home_map_save_interval_s": 30,
      // Output path for the home map file (relative to repo root). The file now carries the
      // occupancy grid, the last sweep and a sample window, so a restart can read it back.
      "home_map_path": "data/home_map.json",
      // Load a home map at start. Empty = load nothing, which is the default: a map recorded in
      // somebody else's room is worse than no map at all.
      "home_map_load_path": "",
      // Cap on cells written to (and read from) a map file. 0 = no cap; the strongest hits are kept.
      "home_map_max_cells": 20000,
      // Metadata for future grid-based mapping.
      "cell_size_cm": 10,
      // Enable the lightweight occupancy-grid ingestion from scan samples.
      "grid_enabled": true,
      "grid_size": [100, 100],
      // Opening detection thresholds (from scan data).
      "opening_min_width_cm": 60,
      "opening_max_width_cm": 120,
      "opening_cell_conf_min": 0.6,
      // Safe path thresholds.
      "safe_path_min_width_cm": 40,
      "safe_path_max_width_cm": 200,
      "safe_path_cell_conf_min": 0.5,
      // Safe path scoring weights.
      "safe_path_score_weight_width": 0.6,
      "safe_path_score_weight_distance": 0.4,
      // Routing across the grid (mapping/planner.py, #305). The grid holds *hits*, never free space,
      // so a cell becomes an obstacle at this count: one echo is noise, two in the same cell is a
      // thing. Below it the cell is "not known to be blocked", which is not the same as clear.
      "occupied_hits": 2,
      // How many cells of room a waypoint would like, and what the planner pays for entering a
      // tighter one. This is a preference, never a ban: a doorway is narrow by definition, and a
      // planner that refuses narrow cells cannot leave a room.
      "clearance_cells": 2,
      "clearance_weight": 2.0
    },
    // =====================================================================
    // BEHAVIOR
    // =====================================================================
    "behavior": {
      // Default action when idle.
      "idle_action": "stand",
      // Action when touch is detected.
      "touch_action": "wag tail",
      // Action when sound is detected.
      "sound_action": "shake head",
      // Action when avoidance is requested by perception.
      "avoid_action": "backward",
      // Action used for exploration (optional behavior).
      "explore_action": "forward",
      // Action used for interaction (optional behavior).
      "interact_action": "wag tail",
      // Separate action catalog file for long lists and custom actions.
      "actions_file": "actions.jsonc",
      // Named action sets to use for each behavior mode.
      "action_sets": {
        "idle": "idle",
        "alert": "alert",
        "avoid": "avoid",
        "play": "play",
        "rest": "rest",
        "patrol": "patrol",
        "explore": "explore",
        "interact": "interact"
      },
      // Chance (0-1) that idle re-draws its action once the variety interval below has elapsed.
      // 0 keeps the current idle action forever. It gates a draw now; it no longer picks one (#37).
      "random_idle_chance": 0.6,
      // Minimum seconds before idle may change its action again. Paces the variety: without it a
      // fresh draw every tick (~2 Hz) reads as twitching, and `action_cooldown_s` cannot pace it
      // because that one also holds reactions to touch and sound.
      "idle_variety_interval_s": 8.0,
      // Seconds an action is excluded from its bucket after being used, then faded back in from a
      // 5% weight over a second window. This is what turns the 14-entry `idle` bucket into a
      // repertoire instead of a two-action loop (#37). 0 disables recency: a uniform draw.
      "action_reuse_cooldown_s": 20.0,
      // Energy band. Above this reading `idle` draws from its own bucket only; below it the `rest`
      // actions join the pool and outrank it, saturating at `autonomy_rest_energy_max` (0.35) — so a
      // tired dog starts dozing off while idle instead of only once autonomy moves it to `rest`. The
      // band opens at 0.5 rather than at the rest threshold on purpose: under autonomy the rest state
      // wins at 0.35, so a bias confined below it would never be seen. 0 switches the band off.
      // Needs an `energy_level` reading (`settings.energy.enabled`); without one it does nothing
      // at all.
      "energy_bias_start": 0.5,
      // Social bias (P4 PL3). Somebody in front of the dog raises the `interact` weight in the
      // autonomy draw, beside `personality.sociability`: `social_bias_peak` is how much more
      // likely `interact` is at full presence, and `social_decay_s` is how long the interest lasts
      // once the sight is lost. Needs an `occupancy` reading with `occupancy_valid` true —
      // `settings.perception.occupancy` plus a detector publishing `faces` — and does nothing at
      // all without one. `social_bias_enabled: false` leaves the weight table exactly as it was.
      "social_bias_enabled": true,
      "social_bias_peak": 2.5,
      "social_decay_s": 5.0,
      // Minimum time between behavior action changes (seconds).
      "action_cooldown_s": 0.0,
      // One expression per state, emitted once when the FSM enters that state — never every tick.
      // `action_cooldown_s` above decides how long it is held. Names come from the action catalog
      // (`actions.jsonc`): an action nothing classifies is refused with a warning, and locomotion is
      // refused too, because a beat is an expression and not a second way to walk the dog. The
      // locomotion states (`avoiding`, `patrol`, `explore`) deliberately ship no beat. A state left
      // out simply has no beat.
      //
      // `sound` is a cue, not an action: it rides the command the entry already publishes, so a
      // locomotion state can announce itself without giving up its step, and the beat is never
      // delayed. It is suppressed while `quiet_mode` is active. `cue_sounds` below documents a stock
      // build; a cue outside it plays without a complaint, and the HAL reports a sound the vendor
      // cannot find - once, in its own words. That is the only warning worth reading.
      "state_expressions": {
        "idle": { "action": "relax neck" },
        "alert": { "action": "head_up_down", "sound": "single_bark_1" },
        "play": { "action": "wag tail", "sound": "woohoo" },
        "interact": { "action": "tilting_head", "sound": "pant" },
        "rest": { "action": "nod", "sound": "snoring" }
      },
      // Volume for the entry cues, 0-100. Quieter than the HAL's own 70: an entry should not
      // startle the room.
      "cue_volume": 60,
      // The effects a stock PiDog ships (`docs/pidog/PIDOG-EXPRESSION.md`). Documentation of a stock
      // build, not a whitelist: a custom build may ship its own and no module warns about a cue that
      // is missing from this list. Whether the file exists at all is the HAL's question.
      "cue_sounds": [
        "angry",
        "confused_1",
        "confused_2",
        "confused_3",
        "growl_1",
        "growl_2",
        "howling",
        "pant",
        "single_bark_1",
        "single_bark_2",
        "snoring",
        "woohoo"
      ],
      // Optional micro-idle behaviors (lifelike idle). Disabled by default.
      "micro_idle_enabled": true,
      // Candidate actions to emit during idle (must exist in action catalog).
      "micro_idle_actions": ["shake head", "wag tail", "stretch"],
      // Minimum interval between micro-idle actions (seconds).
      "micro_idle_interval_s": 12.0,
      // Chance (0-1) to emit a micro-idle action when eligible.
      "micro_idle_chance": 0.2,
      // Habituation: optionally suppress repeated stimuli (touch/sound)
      // Default: disabled. When enabled, repeated identical stimuli will be
      // ignored after `habituation_threshold` occurrences until `habituation_recovery_s` elapses.
      "habituation_enabled": false,
      "habituation_threshold": 3,
      "habituation_recovery_s": 30.0,
      // Enable behavior transition guard (cooldown + confirmation) to reduce jitter.
      "transition_guard_enabled": false,
      // Minimum time (seconds) to remain in a state before switching (when guard enabled).
      "transition_min_dwell_s": 0.6,
      // Confirmation ticks required before switching states (when guard enabled).
      "transition_confirm_ticks": 2,
      // States that bypass transition guard (always immediate).
      "transition_immediate_states": ["avoiding", "alert"],
      // Autonomous mode selection.
      "autonomy_enabled": true,
      "autonomy_interval_s": 8.0,
      "autonomy_modes": ["idle", "patrol", "explore", "interact", "play", "rest"],
      "autonomy_weights": {
        "idle": 0.35,
        "patrol": 0.25,
        "explore": 0.15,
        "interact": 0.1,
        "play": 0.1,
        "rest": 0.05
      },
      "autonomy_rest_energy_max": 0.35,
      "autonomy_play_energy_min": 0.75,
      "patrol_action": "forward",
      // Idle behavior registry choices (weighted or sequential).
      "idle_choices": ["idle_behavior", "rest_behavior"],
      "behavior_selection_mode": "weighted",
      "behavior_weights": {
        "idle_behavior": 0.8,
        "rest_behavior": 0.2
      },
      // Action catalog is loaded from actions.jsonc (kept here for reference).
      "catalog": {}
    },
    // =====================================================================
    // PERSONALITY & BEHAVIOR TUNING
    // =====================================================================
    "personality": {
      // High-level personality multipliers (0-10). Values near 0 reduce the
      // relative influence of a behavior; values >1 increase it.
      "curiosity": 0.5,
      "sociability": 0.5,
      "activity": 0.5,
      // Optionally apply personality multipliers to autonomy weights.
      "apply_to_autonomy": true
    },
    // =====================================================================
    // ENERGY & EMOTION (optional)
    // =====================================================================
    // `energy_level` has one producer — the behaviour module — and `enabled` here is its switch.
    // `modules.energy_emotion` only derives from the reading (speed hint, emotion label, LED):
    // enabling it without `enabled: true` here gets a warning and no output, because there is
    // nothing to read (two producers decaying one number per tick was #85).
    "energy": {
      "enabled": false,
      "initial": 0.6,
      "min": 0.0,
      "max": 1.0,
      "decay_per_tick": 0.01,
      "boost_touch": 0.08,
      "boost_sound": 0.05,
      "boost_obstacle": 0.02,
      "speed_slow_threshold": 0.35,
      "speed_fast_threshold": 0.75
    },
    "emotion": {
      "led_enabled": false,
      "led_cooldown_s": 1.0,
      "led_colors": {
        "calm": "blue",
        "alert": "orange",
        "excited": "green",
        "tired": "purple"
      }
    },
    // =====================================================================
    // LED MANAGER (centralized RGB control)
    // =====================================================================
    "led": {
      "enabled": true,
      // The order is the precedence: the list is walked front to back and the first source with a
      // live request owns the strip, so "safety" first is a guarantee. Reordering overrides it —
      // that is the only lever; the numeric priority a producer puts on a request is not read.
      // "health" is sensor_health, which ships disabled; the slot only matters once it is enabled.
      "priority": ["safety", "health", "navigation", "attention", "emotion"],
      "cooldown_s": 0.4,
      "brightness": 0.7,
      "default_color": "blue",
      "safety_color": "red",
      "safety_mode": "boom",
      "attention_color": "cyan",
      "attention_mode": "listen",
      // Sensor-health colours come from `sensor_health.led_*_color` on the request; this is the
      // effect they run at.
      "health_mode": "breath",
      "nav_mode": "breath",
      "nav_turn_mode": "listen",
      "nav_obstacle_mode": "bark",
      "nav_retreat_mode": "boom",
      "emotion_mode": "breath",
      "emotion_color": "blue",
      // LED effect rate, per source, e.g. `{"safety": 4}` runs the safety effect at 4 bps. Empty by
      // default, which leaves every effect at the vendor's rate — the same rate it ran at before
      // this key existed. A request may carry its own `bps` instead.
      "bps": {},
      // What the strip returns to when the request that owned it expires and nothing else is live
      // (`default_color` + this effect). Before this, the last colour simply stayed.
      "idle_mode": "breath"
    },
    // =====================================================================
    // ATTENTION (sound direction -> head yaw)
    // =====================================================================
    "attention": {
      "enabled": true,
      "sound_cooldown_s": 0.5,
      "head_yaw_max_deg": 60.0,
      "head_turn_speed": 70,
      "respect_scanning": true,
      "scan_block_s": 0.4
    },
    // =====================================================================
    // MOTORS
    // =====================================================================
    "motors": {
      // Minimum delay (seconds) between queued actions.
      "min_action_interval_s": 0.2,
      // Head follows body turns for more natural movement.
      "head_turn_follow_enabled": true,
      // Degrees to yaw the head when turning (same direction as turn).
      "head_turn_follow_deg": 12.0,
      // Head turn speed for follow behavior.
      "head_turn_follow_speed": 70,
      // How long to hold the head offset before returning to center (seconds).
      "head_turn_follow_hold_s": 0.4,
      // If true, avoid head follow shortly after scans.
      "head_turn_follow_respect_scanning": true,
      // Block head follow for this long after a scan update (seconds).
      "head_turn_follow_scan_block_s": 0.4,
      // If true, avoid head follow shortly after attention head turns.
      "head_turn_follow_respect_attention": true,
      // Block head follow for this long after attention (seconds).
      "head_turn_follow_attention_block_s": 0.6
    },
    // =====================================================================
    // CALIBRATION HOOKS
    // =====================================================================
    "calibration": {
      // Stored servo zero offsets (joint name -> signed degrees, clamped to +/-20). The keys are
      // the vendor's joint order: lf_shoulder, lf_leg, rf_shoulder, rf_leg, lh_shoulder, lh_leg,
      // rh_shoulder, rh_leg, head_yaw, head_roll, head_pitch, tail. Filled by calibration runs;
      // the vendor's own file in ~/.config/pidog/pidog.conf stays the authority.
      "servo_zero_offsets": {},
      // Default calibration behavior options.
      "auto_apply_servo_offsets": false,
      // Persist calibration outputs to a JSON file (separate from settings).
      "persist_enabled": true,
      "persist_path": "data/calibration.json",
      // Optional calibration request: servo_zero | wall_follow | corner_seek | landmark_align
      "request": null,
      // Calibration tuning values.
      "wall_follow_target_distance_cm": 30.0,
      "corner_seek_turn_deg": 45.0,
      "landmark_alignment_confidence_min": 0.6,
      // Bump localization confidence after a successful calibration.
      "localization_confidence_bump": 0.1
    },
    // =====================================================================
    // SAFETY
    // =====================================================================
    "safety": {
      // Distance (cm) that triggers an emergency backup.
      "too_close_cm": 10,
      // Emergency stop override (highest priority).
      "emergency_stop_enabled": false,
      // Distance (cm) that triggers emergency stop action.
      "emergency_stop_cm": 8,
      // ActionFlow action used for emergency stop.
      "emergency_stop_action": "lie",
      // Cooldown between emergency stop actions (seconds).
      "emergency_stop_cooldown_s": 2.0,
      // If true, attempt to call hardware-level stop methods on PiDog.
      "emergency_stop_use_hardware_stop": true,
      // Tilt detection threshold (degrees). If exceeded, safety will trigger.
      "tilt_threshold_deg": 45.0,
      // Action to run when tilt threshold is exceeded.
      "tilt_action": "lie",
      // Cooldown between tilt triggers (seconds).
      "tilt_cooldown_s": 1.0,
      // Priority order for action overrides (highest first).
      "override_priority": ["safety", "watchdog", "navigation", "behavior"],
      // Clear lower-priority actions when safety is active.
      "override_clear_lower": true
    },
    // =====================================================================
    // WATCHDOG (hold motion, restart what stopped)
    // =====================================================================
    "watchdog": {
      // Enable the watchdog. Recovery is "stop and report": a stale reading holds motion, it
      // never poses the dog, and a module that keeps failing is eventually left failed.
      "enabled": true,
      // Treat sensor data as stale after this window (seconds).
      "sensor_timeout_s": 2.0,
      // Minimum staleness window for scans (seconds). The effective window is the larger of
      // this and 1.5x the measured scan duration, because a sweep takes ~2.6 s at the shipped
      // settings and a scan cannot be staler than it takes to run one.
      "scan_timeout_s": 2.0,
      // Per-module heartbeat timeout (seconds).
      "module_timeout_s": 4.0,
      // Modules to monitor (empty = every enabled, started module).
      "monitor_modules": [],
      // Modules never to restart. The watchdog adds itself, so it cannot restart itself.
      // `api` is exempt on purpose: a restart re-binds the port and drops every client. The
      // exemption is reported in /state `supervisor.exempt`, so it stays visible rather than
      // silently reading as healthy (#25).
      "ignore_modules": ["api"],
      // Base delay before another restart of the same module (seconds).
      "restart_cooldown_s": 1.0,
      // Each consecutive failure waits this much longer: 1x, 2x, 4x ... capped below.
      "restart_backoff_factor": 2.0,
      // Upper bound on the backoff delay (seconds).
      "restart_max_delay_s": 60.0,
      // Restart attempts before the module is reported failed and left alone.
      "max_restarts": 3,
      // A restarted module must stay healthy this long before it earns a fresh budget.
      "healthy_after_s": 30.0
    },
    // =====================================================================
    // BALANCE (IMU-based posture compensation)
    // =====================================================================
    "balance": {
      "enabled": false,
      "update_hz": 10.0,
      "compensation_scale": 1.0,
      "max_pitch_deg": 12.0,
      "max_roll_deg": 12.0,
      "lpf_alpha": 0.4,
      "active_when_moving": true,
      "active_actions": ["forward", "backward", "turn left", "turn right", "trot"]
    },
    // =====================================================================
    // LOGGING & TELEMETRY (lightweight)
    // =====================================================================
    "logging": {
      // Enable/disable console logging.
      "enable_console": true,
      // Enable/disable file logging.
      "enable_file": true,
      // Log directory and file name.
      "log_dir": "logs",
      "log_file_name": "houndmind.log",
      "log_max_entries": 1000,
      // Status log output to terminal can be disabled.
      "status_log_enabled": true,
      "status_log_interval_s": 10,
      // Default to verbose logging for better support bundles.
      "log_level": "DEBUG",
      "log_file_max_mb": 10,
      "log_file_backups": 5,
      // Event logger (ring buffer + JSONL).
      "event_log_enabled": true,
      "event_log_interval_s": 0.5,
      "event_log_max_entries": 1000,
      "event_log_file_enabled": true,
      "event_log_path": "logs/houndmind_events.jsonl",
      // Cap on the JSONL file itself. When it reaches this size it is renamed to `.1` and a
      // fresh file is started, so a dog left running cannot fill the SD card.
      "event_log_max_mb": 5,
      // Decision feed (per-tick ring + optional JSONL). Separate from the event log on purpose:
      // the ring feeds `/decisions` and the `decision` socket event, so it keeps working on a
      // device that turned the event log off.
      "decision_log_enabled": true,
      "decision_log_max_entries": 200,
      // Off by default: ten records a second is ~9 MB an hour, so this file is opt-in for a
      // post-mortem or a replay run.
      "decision_log_file_enabled": false,
      "decision_log_path": "logs/houndmind_decisions.jsonl",
      // One rotated generation at this size, the same rule as the event log.
      "decision_log_max_mb": 5,
    },
    // =====================================================================
    // PERFORMANCE SAFEGUARDS
    // =====================================================================
    "performance": {
      // Scan interval bounds used by validation warnings.
      "scan_interval_min_s": 0.2,
      "scan_interval_max_s": 2.0,
      // Upper bound for sensor polling, enforced against sensors.poll_hz at load.
      "sensor_poll_hz_max": 20,
      // Health thresholds used by the health monitor to decide when to degrade.
      "health_load_per_core_warn_multiplier": 1.5,
      "health_temp_warn_c": 70.0,
      "health_gpu_temp_warn_c": 75.0,
      "health_mem_used_warn_pct": 85.0,
      "health_monitor_interval_s": 5.0,
      "health_scan_interval_multiplier": 2.0,
      "health_scan_interval_abs_delta": 1.0,
      "health_vision_frame_interval_multiplier": 2.0,
      "health_vision_frame_interval_abs_delta": 0.2,
      // Degradation levers the health monitor may pull: throttle_scans, throttle_vision.
      "health_actions": [],
      // Safe mode: reduces scan cadence and turn speed on a loaded board.
      "safe_mode_enabled": false,
      "safe_mode_scan_interval_s": 1.2,
      "safe_mode_turn_speed": 140,
      // Warn when a runtime tick exceeds this duration (seconds).
      "runtime_tick_warn_s": 0.4,
      // Smoothing factor for the reported tick-duration average (0-1].
      "runtime_ema_alpha": 0.2
    },
    // =====================================================================
    // BATTERY / VOLTAGE (optional)
    // =====================================================================
    "battery": {
      "enabled": false,
      // Optional voltage threshold (set if hardware exposes voltage).
      "low_voltage_v": 6.8,
      // Optional percent threshold (0-1) if percent is available.
      "low_percent": 0.2,
      // Behavior override when low battery is detected.
      "behavior_override": "rest_behavior"
    },
    // =====================================================================
    // QUIET MODE (optional schedule-based throttling)
    // =====================================================================
    "quiet_mode": {
      "enabled": false,
      // Local time (hours 0-23). Supports overnight windows (e.g., 22 -> 7).
      "start_hour": 22,
      "end_hour": 7,
      // Slow down scanning during quiet mode (seconds).
      "scan_interval_s": 1.2,
      // Extra cooldown between behavior action changes (seconds).
      "behavior_action_cooldown_s": 1.5,
      // Minimum delay between motor actions (seconds).
      "motor_min_action_interval_s": 0.6
    },
    // =====================================================================
    // ROUTINES (user-authored step lists; behavior/routine_runner.py reads them)
    // =====================================================================
    "routines": {
      // One JSON file per routine. `~` is expanded at startup. A missing directory
      // is an empty list, not an error, and the dog never writes here.
      "dir": "~/.houndmind/routines"
    },

    // =====================================================================
    // PLACES (named poses a user teaches; kernel/place_store.py owns the file)
    // =====================================================================
    "places": {
      // One JSON file holding every place. `~` is expanded at startup. A missing
      // file is an empty list, not an error, and nothing invents a place: they
      // are created by a person (or a routine step), never inferred from a scan.
      // A file with a bad entry keeps the good ones and reports the rest; before
      // any write over such a file, its previous contents are copied to
      // `<path>.bak`. Requires `behavior` + `navigation` for the dog to go there.
      "path": "~/.houndmind/places.json",

      // How the dog walks to one (navigation/place_navigator.py). A place is a heading and a
      // distance from an anchor, so reaching it is "orient, step, re-check" — one motion intent at
      // a time through the gateway, and an obstacle always outranks the goal.
      //
      // The anchor this run navigates in. A place taught against a different one is refused by
      // name rather than walked on a stale vector, and a request must confirm the dog stands at
      // the anchor ("at_anchor": true) because nothing here can verify that pose.
      "anchor": "sonar_baseline",
      // Arriving inside this many cm of the stored distance counts as arrived.
      "tolerance_cm": 15,
      // How far off the heading the dog may be and still count as facing the place (degrees).
      "turn_tolerance_deg": 8,
      // Dead reckoning: how far one accepted `forward` is believed to carry the dog. NOTHING
      // measures travel, so this is a guess until it is measured on the device — a wrong value
      // makes every trip short or long by the same ratio.
      "step_cm": 25,
      // Give up after this long (seconds). 0 means never.
      "timeout_s": 120,
      // How much one arrival raises a place's confidence, and one failed approach lowers it.
      "confidence_step": 0.1
    },

    // =====================================================================
    // PLACE RECOGNITION (navigation/place_recognition.py + perception/place_views.py)
    // =====================================================================
    "place_recognition": {
      // A view is the artefact a place is recognised by: a 32x24 thumbnail, the ORB keypoints and
      // descriptors, and when it was taken. One `views.json` per directory, so a place taught on
      // the dog can be scored off it by `python -m tools.place_match`.
      "views_dir": "~/.houndmind/places/views",
      // Below this share of matched descriptors the answer is "no idea" with the score attached.
      // Measured on synthetic fixtures only so far: lower it and two doorways become one room.
      "min_score": 0.45,
      // How many consecutive frames must name the same place before the pose is corrected. 1 makes
      // a single lucky frame move the dog's idea of where it is; 2 is the shipped compromise.
      "confirm_frames": 2,
      // At most one frame is scored per this many seconds. The camera may run at 30 Hz; matching is
      // the expensive part and a place does not change between steps.
      "interval_s": 1.0
    },

    // =====================================================================
    // ROUTE FOLLOWER (navigation/route_follower.py; plans with mapping/planner.py)
    // =====================================================================
    "route_follower": {
      // A waypoint counts as reached inside this radius. Generous on purpose: a waypoint is a cell
      // centre and the pose is dead reckoning, so a tight radius is a dog that never arrives.
      "tolerance_cm": 12,
      // Turn first when the bearing is off by more than this, walk second.
      "heading_tolerance_deg": 20,
      // Give up on a route that has not finished in this long. 0 means never.
      "timeout_s": 300
    },

    // =====================================================================
    // CONTROL PLANE (services/api.py) — one port for REST, WebSocket, MJPEG
    // =====================================================================
    "api": {
      // Bind address. Reachable on the LAN on purpose — but the traffic is NOT encrypted: the
      // token, every command and every camera frame cross the network in the clear, so this host
      // reachable means the token is readable by anyone who can watch the LAN (see #18).
      // Use "127.0.0.1" plus an SSH tunnel, or a firewall rule, to keep it private; disable
      // `modules.api` to remove the surface entirely.
      "host": "0.0.0.0",
      "port": 8420,
      // The install-issued API token. Generated on first start, 0600, never pasted into this
      // file and never written to a log.
      "token_path": "~/.houndmind/api_token",
      // TLS (#18). Off serves plaintext HTTP on every interface, which is what the warning at the
      // top of this block is about. On serves HTTPS with a self-signed certificate, generated on
      // first start when neither file below exists — that needs `openssl` on the device.
      // A self-signed certificate has to be trusted once by each client: the browser shows a
      // warning until it is, and an Android client rejects it by default (see docs/INSTALL.md).
      "tls_enabled": false,
      "tls_cert": "~/.houndmind/tls/cert.pem",
      "tls_key": "~/.houndmind/tls/key.pem",
      // Pre-built web app location. Null means the copy bundled with the package.
      "static_root": null,
      // Telemetry push rate on /api/v1/events.
      "state_hz": 10.0,
      // Pairing codes for the Android app and a second browser: 6 digits, 5 minutes, one use.
      "pairing_enabled": true,
      "pairing_attempts_per_minute": 5,
      // Bounded command inbox. A full queue is a 429, never latency on the servo bus.
      "command_queue": 64,
      // How long POST /api/v1/command waits for the interlock's verdict before answering 503.
      "command_ack_timeout_s": 0.5,
      // A connected client that stops pinging for this long loses its command.
      "link_loss_s": 6.0,
      "max_clients": 8,
      // Default and maximum `GET /api/v1/logs?tail=`.
      "log_tail": 200,
      // Findable by name on the LAN (#38): one mDNS record, `houndmind._houndmind._tcp.local`,
      // carrying the host, the port and the API version. Everything in it is already in the
      // public /meta payload - no token, no secret, no location. Discovery is a convenience:
      // a network that blocks multicast costs one log line and the address still works.
      "discovery_enabled": true,
      // The instance name a client sees, so two dogs on one LAN stay distinguishable.
      "discovery_name": "houndmind",
      // Cross-origin reads (#202). Empty means no page from another origin may read this plane -
      // the shipped default, and what a single-console install wants. Add an origin (scheme, host,
      // port, no trailing slash) to let that console fetch from here in place; the token is still
      // the boundary, and `*` is ignored rather than honoured. Mixed content still applies: an
      // https page cannot call an http plane, so put both on the same scheme.
      "cors_origins": []
    }
  }
}
